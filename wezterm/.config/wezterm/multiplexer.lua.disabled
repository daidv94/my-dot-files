-- WezTerm's own multiplexing layer, removed from wezterm.lua on 2026-08-17.
--
-- WHY IT WAS REMOVED
-- tmux is the only multiplexer now. This layer duplicated seven tmux actions
-- (split, new tab, zoom, close pane, last tab, tab 1-9, rename) behind a second
-- prefix, which meant every split started with "which multiplexer am I in?".
-- tmux wins that comparison on session persistence (tmux-resurrect/continuum),
-- SSH, detach/reattach, and vim-tmux-navigator integration. See "Keybinding
-- layers" in the repo README.
--
-- HOW TO RE-ENABLE (switching to WezTerm-only, dropping tmux)
--   1. Rename this file to multiplexer.lua
--   2. In wezterm.lua, after `config` is built:
--        require("multiplexer").apply(config)
--   3. Remove the tmux prefix so C-a is free, or stop launching tmux.
--   4. Swap nvim's vim-tmux-navigator for mrjones2014/smart-splits.nvim, which
--      is what makes C-h/j/k/l cross WezTerm panes and nvim splits. The
--      commented-out `is_vim` helper below is the guard smart-splits needs.
--      vim-tmux-navigator will NOT drive WezTerm panes.
--
-- NOTE ON THE ORIGINAL KEYS
-- Navigation sat on CMD+hjkl and resize on CTRL|SHIFT+hjkl, deliberately
-- avoiding bare CTRL+hjkl so those passed through to tmux. With tmux gone that
-- constraint disappears: move navigation to CTRL+hjkl to match the nvim
-- keymaps in lua/plugins/, which is the whole point of smart-splits.

local wezterm = require("wezterm")
local action = wezterm.action

local M = {}

-- Required by smart-splits.nvim; the plugin sets this user var and clears it on
-- ExitPre. Used to decide whether a directional key belongs to nvim or WezTerm.
local function is_vim(pane)
  return pane:get_user_vars().IS_NVIM == "true"
end

local direction_keys = {
  h = "Left",
  j = "Down",
  k = "Up",
  l = "Right",
}

local function split_nav(key)
  return {
    key = key,
    mods = "CMD",
    action = action.ActivatePaneDirection(direction_keys[key]),
  }
end

-- `random_background` lives in wezterm.lua; pass it in if the background
-- binding is ever moved here too.
function M.apply(config)
  config.leader = { key = "b", mods = "CTRL", timeout_milliseconds = 1500 }

  local keys = {
    -- Double Ctrl-b sends a literal Ctrl-b to the pane
    { key = "b", mods = "LEADER|CTRL", action = action.SendKey({ key = "b", mods = "CTRL" }) },
    -- Change the tab title name
    {
      key = ",",
      mods = "LEADER",
      action = action.PromptInputLine({
        description = "Enter new name for tab",
        action = wezterm.action_callback(function(window, pane, line)
          if line then
            window:active_tab():set_title(line)
          end
        end),
      }),
    },
    split_nav("h"),
    split_nav("j"),
    split_nav("k"),
    split_nav("l"),
    -- splitting
    {
      mods = "LEADER",
      key = "-",
      action = action.SplitVertical({ domain = "CurrentPaneDomain" }),
    },
    {
      mods = "LEADER",
      key = "\\",
      action = action.SplitHorizontal({ domain = "CurrentPaneDomain" }),
    },
    {
      mods = "LEADER",
      key = "c",
      action = action({ SpawnTab = "CurrentPaneDomain" }),
    },
    -- Adjust the panel size
    { key = "h", mods = "CTRL|SHIFT", action = action.AdjustPaneSize({ "Left", 5 }) },
    { key = "l", mods = "CTRL|SHIFT", action = action.AdjustPaneSize({ "Right", 5 }) },
    { key = "j", mods = "CTRL|SHIFT", action = action.AdjustPaneSize({ "Down", 5 }) },
    { key = "k", mods = "CTRL|SHIFT", action = action.AdjustPaneSize({ "Up", 5 }) },
    { key = "m", mods = "LEADER", action = action.TogglePaneZoomState },
    { key = "p", mods = "LEADER", action = action.ActivateTabRelative(-1) },
    { key = "n", mods = "LEADER", action = action.ActivateTabRelative(1) },
    { key = "l", mods = "LEADER", action = action.ActivateLastTab },
    { key = "x", mods = "LEADER", action = action.CloseCurrentPane({ confirm = false }) },
  }

  for i = 1, 9 do
    table.insert(keys, {
      key = tostring(i),
      mods = "LEADER",
      action = action.ActivateTab(i - 1),
    })
  end

  config.keys = config.keys or {}
  for _, k in ipairs(keys) do
    table.insert(config.keys, k)
  end

  return config
end

M.is_vim = is_vim

return M
